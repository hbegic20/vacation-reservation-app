generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EMPLOYEE
}

enum VacationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AbsenceType {
  VACATION
  SICK
}

enum NotificationType {
  VACATION_REQUEST_SUBMITTED
  VACATION_APPROVED
  VACATION_REJECTED
  VACATION_CANCELLED
  COVER_ASSIGNED
  LEAVE_REMINDER
  DOCUMENT_PUBLISHED
  SICK_LEAVE_ADDED
  DAILY_DIGEST
}

model User {
  id                 String            @id @default(cuid())
  email              String            @unique
  password           String
  role               UserRole          @default(EMPLOYEE)
  firstName          String
  lastName           String
  department         String?
  isActive           Boolean           @default(true)
  mustChangePassword Boolean           @default(false)
  vacationDaysTotal  Int               @default(25)
  vacationDaysUsed   Int               @default(0)
  requests           VacationRequest[]
  coveringRequests   VacationRequest[] @relation("Coverage")
  uploadedDocuments  Document[]
  notifications      Notification[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model VacationRequest {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  coverUserId    String?
  coverUser      User?          @relation("Coverage", fields: [coverUserId], references: [id], onDelete: SetNull)
  reminderSentAt DateTime?
  startDate      DateTime
  endDate        DateTime
  reason         String
  workingDays    Int            @default(0)
  absenceType    AbsenceType    @default(VACATION)
  status         VacationStatus @default(PENDING)
  adminComment   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
  @@index([status])
  @@index([coverUserId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

model PublicHoliday {
  id        String   @id @default(cuid())
  date      DateTime @unique
  name      String
  createdAt DateTime @default(now())
}

model Document {
  id           String    @id @default(cuid())
  title        String
  description  String?
  fileName     String
  mimeType     String
  sizeBytes    Int
  content      Bytes
  isPublished  Boolean   @default(false)
  publishedAt  DateTime?
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isPublished, publishedAt])
}
